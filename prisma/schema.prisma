generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  passwordHash         String    @map("password_hash")
  displayName          String    @map("display_name")
  /** IANA 时区，聊天 prompt 本地时间以库为准 */
  timeZone             String    @default("Asia/Shanghai") @map("time_zone")
  /** maintain→profile 管线上次两者都成功完成的时刻 */
  lastMemoryPipelineAt DateTime? @map("last_memory_pipeline_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  authSessions AuthSession[]
  sessions     ChatSession[]
  memories     UserMemory[]
  profile      UserProfile?

  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model ChatSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String    @default("新对话")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@map("chat_sessions")
}

model Message {
  id                 String      @id @default(uuid())
  sessionId          String      @map("session_id")
  role               String
  parts              Json
  isConsolidated     Boolean     @default(false) @map("is_consolidated")
  isDeleted          Boolean     @default(false) @map("is_deleted")
  consolidationJobId String?     @map("consolidation_job_id")
  session            ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([sessionId, isConsolidated])
  @@index([sessionId, isDeleted])
  @@index([consolidationJobId])
  @@map("messages")
}

model UserMemory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  text         String   @db.Text
  type         String // preference | event | fact
  confidence   Float    @default(0.7)
  isDeleted    Boolean  @default(false) @map("is_deleted")
  isMaintained Boolean  @default(false) @map("is_maintained")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDeleted])
  @@index([userId, isDeleted, lastActiveAt])
  @@index([userId, isDeleted, isMaintained, createdAt])
  @@map("user_memories")
}

model UserProfile {
  userId        String   @id @map("user_id")
  summary       String?  @db.Text
  facets        Json?
  sourceVersion Int      @default(0) @map("source_version")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ConsolidationJob {
  id          String    @id @default(uuid())
  kind        String    @default("extract") // extract | maintain | profile
  status      String    @default("pending") // pending | running | completed | failed
  progress    String    @default("等待开始...")
  error       String?   @db.Text
  result      Json?
  snapshot    Json? // 任务上下文 + 记忆整理大模型对话 rawPayload
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([startedAt])
  @@map("consolidation_jobs")
}

model File {
  id        String      @id @default(uuid())
  fileName  String      @map("file_name")
  ossKey    String      @map("oss_key") // 存储在 MinIO 中的唯一 Object Key
  fileSize  Int         @map("file_size")
  chunks    FileChunk[]
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("files")
}

model FileChunk {
  id             String @id @default(uuid())
  fileId         String @map("file_id")
  chunkIndex     Int    @map("chunk_index") // 切片排序索引 (0, 1, 2...)
  contentPreview String @map("content_preview") @db.Text // 存储纯文本，用于兜底或普通展示
  file           File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("file_chunks")
}
