generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/**
 * 登录用户；画像与长期记忆均按 userId+characterId 私有
 */
model User {
  id              String   @id @default(uuid())
  username        String   @unique
  passwordHash    String   @map("password_hash")
  displayName     String   @map("display_name")
  /// UI 语言偏好（en | zh）；注册时由客户端 body 写入
  locale          String   @default("zh")
  /// 用户自备 OpenAI 兼容对话接口；三项齐全才视为启用。密钥只存密文。
  llmBaseUrl      String?  @map("llm_base_url")
  llmApiKeyCipher String?  @map("llm_api_key_cipher") @db.Text
  llmModel        String?  @map("llm_model")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  authSessions   AuthSession[]
  sessions       ChatSession[]
  groupSessions  GroupSession[]
  userCharacters UserCharacter[]
  memories       UserMemory[]
  profiles       UserProfile[]

  @@map("users")
}

/**
 * AI 角色目录（全局）；人设/skills 在 prompts，不在本表
 */
model Character {
  id             String          @id @default(uuid())
  slug           String          @unique
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  sessions       ChatSession[]
  groupMembers   GroupMember[]
  spokenMessages Message[]
  userCharacters UserCharacter[]
  memories       UserMemory[]
  profiles       UserProfile[]

  @@map("characters")
}

/**
 * 用户通讯录：已添加的 AI 好友（单聊前提；建群成员须已在此）
 */
model UserCharacter {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  characterId          String    @map("character_id")
  /**
   * 该用户×角色 maintain→profile 管线上次两者都成功完成的时刻
   */
  lastMemoryPipelineAt DateTime? @map("last_memory_pipeline_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character            Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([userId])
  @@map("user_characters")
}

/**
 * Cookie 登录会话（鉴权），与聊天 ChatSession 无关
 */
model AuthSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/**
 * 单聊：每用户每角色至多一条会话
 */
model ChatSession {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  characterId         String    @map("character_id")
  title               String    @default("新对话")
  /**
   * 非空表示正在生成；超时后可被新请求抢占
   */
  generatingStartedAt DateTime? @map("generating_started_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character           Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages            Message[]

  @@unique([userId, characterId])
  @@index([userId])
  @@map("chat_sessions")
}

/**
 * 群聊会话；用户为 owner，AI 成员见 GroupMember
 */
model GroupSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   @default("群聊")
  /**
   * 非空表示正在生成；超时后可被新请求抢占
   */
  generatingStartedAt DateTime? @map("generating_started_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  messages Message[]

  @@index([userId])
  @@map("group_sessions")
}

/**
 * 群内 AI 成员；与 UserCharacter（通讯录）不同，仅表示本群在场角色
 */
model GroupMember {
  id             String   @id @default(uuid())
  groupSessionId String   @map("group_session_id")
  characterId    String   @map("character_id")
  createdAt      DateTime @default(now()) @map("created_at")

  groupSession GroupSession @relation(fields: [groupSessionId], references: [id], onDelete: Cascade)
  character    Character    @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@unique([groupSessionId, characterId])
  @@index([characterId])
  @@map("group_members")
}

/**
 * 单聊 / 群聊共用消息表。
 * sessionId 与 groupSessionId 恰好一个非空（应用层校验）。
 * speakerCharacterId：null = 用户；非空 = 该 AI（群聊助手消息应填写）。
 * kind：null = 普通消息；turn_cue = 群聊续聊触发语（role 仍为 user）。
 */
model Message {
  id                 String   @id @default(uuid())
  sessionId          String?  @map("session_id")
  groupSessionId     String?  @map("group_session_id")
  speakerCharacterId String?  @map("speaker_character_id")
  role               String
  kind               String?  @map("kind")
  parts              Json
  isConsolidated     Boolean  @default(false) @map("is_consolidated")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  consolidationJobId String?  @map("consolidation_job_id")
  createdAt          DateTime @default(now()) @map("created_at")

  session          ChatSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  groupSession     GroupSession? @relation(fields: [groupSessionId], references: [id], onDelete: Cascade)
  speakerCharacter Character?    @relation(fields: [speakerCharacterId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([groupSessionId])
  @@index([sessionId, isConsolidated])
  @@index([groupSessionId, isConsolidated])
  @@index([sessionId, isDeleted])
  @@index([groupSessionId, isDeleted])
  @@index([consolidationJobId])
  @@map("messages")
}

/**
 * 长期用户记忆条目（preference / event / fact）；按 userId + characterId 私有，供 RAG / maintain
 */
model UserMemory {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  characterId  String    @map("character_id")
  text         String    @db.Text
  type         String // preference | event | fact
  confidence   Float     @default(0.7)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  isMaintained Boolean   @default(false) @map("is_maintained")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([userId, characterId, isDeleted])
  @@index([userId, characterId, isDeleted, lastActiveAt])
  @@index([userId, characterId, isDeleted, isMaintained, createdAt])
  @@map("user_memories")
}

/**
 * 用户×角色画像（maintain→profile 产物）；按 userId + characterId 私有
 */
model UserProfile {
  userId        String    @map("user_id")
  characterId   String    @map("character_id")
  text          String?   @db.Text
  sourceVersion Int       @default(0) @map("source_version")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([userId, characterId])
  @@map("user_profiles")
}

/**
 * 记忆流水线任务记录（extract / maintain / profile），与具体会话无 FK
 */
model ConsolidationJob {
  id          String    @id @default(uuid())
  kind        String    @default("extract") // extract | maintain | profile
  status      String    @default("pending") // pending | running | completed | failed
  progress    String    @default("等待开始...")
  error       String?   @db.Text
  result      Json?
  snapshot    Json? // 任务上下文 + 记忆整理大模型对话 rawPayload
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([startedAt])
  @@map("consolidation_jobs")
}
