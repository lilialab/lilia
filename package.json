{
  "name": "lilia",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,extract,maintain -c blue,magenta,magenta \"pnpm dev\" \"pnpm worker:memory-extract\" \"pnpm worker:memory-maintain\"",
    "build": "next build",
    "start": "next start",
    "start:all": "concurrently -n web,extract,maintain -c blue,magenta,magenta \"pnpm start\" \"pnpm worker:memory-extract\" \"pnpm worker:memory-maintain\"",
    "lint": "eslint && tsc --noEmit",
    "format": "dprint fmt",
    "test": "vitest",
    "test:run": "vitest run",
    "worker:memory-extract": "tsx src/workers/memory-extract.worker.ts",
    "worker:memory-maintain": "tsx src/workers/memory-maintain.worker.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.35",
    "@ai-sdk/react": "^4.0.80",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@tanstack/react-query": "^5.101.0",
    "ai": "^7.0.77",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.2",
    "chromadb": "^3.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ioredis": "5.11.1",
    "ldrs": "^1.1.9",
    "lucide-react": "^1.21.0",
    "next": "16.2.6",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dprint/json": "^0.23.0",
    "@dprint/typescript": "^0.96.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.9.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "dprint": "^0.55.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "69.0.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
