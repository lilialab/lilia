NODE_ENV=development

# ============= MySQL（必填）===========
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=lilia
# =======================================

# ============= Chroma（必填）===========
CHROMA_HOST=localhost
CHROMA_PORT=8000
# =======================================

# ============= Redis / BullMQ（必填）===========
# compose 起 Redis 后使用此地址（BullMQ 连接）
REDIS_URL=redis://localhost:6379
# =======================================

# ============= SeaweedFS（对象存储，S3 兼容）===========
# compose 起 SeaweedFS 后使用；S3 API http://localhost:8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=lilia
S3_SECRET_KEY=lilia-s3-secret
S3_BUCKET=lilia
# =======================================

# ============= 日志 / Loki（必填）===========
LOG_LEVEL=debug
LOKI_URL=http://localhost:3100
# true：stdout + Loki；false：仅 stdout
LOG_TO_LOKI=true
# =======================================

# ============= 对话 LLM（必填，OpenAI 兼容）===========
# DeepSeek 示例；硅基流动则用 https://api.siliconflow.cn/v1 与对应模型名
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat
# =======================================

# ============= Embedding（必填，OpenAI 兼容 /v1/embeddings）===========
# 硅基示例；可与 LLM 共用同一 Key / Base（若 LLM 也在硅基）
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-your-siliconflow-key
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# =======================================

# ============= 记忆衰减半衰期（必填）===========
# 用于聊天 RAG 排序与维护近邻 decay；详见 docs/memory/maintain.md
# event 型：lastActiveAt 距今达此天数时 decay≈0.5
MEMORY_HALF_LIFE_EVENT_DAYS=30

# fact 型半衰期（天）
MEMORY_HALF_LIFE_FACT_DAYS=90
# =======================================

# ============= 记忆维护（必填）===========
# 每条游标最多召回的语义近邻数
MEMORY_MAINTAIN_NEIGHBOR_LIMIT=10

# 近邻 decay 硬过滤阈值 (0,1]；低于此值不进入 LLM 合并簇
# 聊天 RAG 会 touch 语义命中并回写 lastActiveAt，仍被聊到的旧记忆保持活跃
# 过滤久未 touch 的近邻，无需担心跳过重要旧记忆；默认 0.25≈2×半衰期
MEMORY_MAINTAIN_NEIGHBOR_MIN_DECAY=0.25
# =======================================

# ============= 聊天 RAG（必填）===========
# 进入 system prompt 的记忆条数上限
MEMORY_RAG_LIMIT=5

# Chroma 候选倍数（先召回 limit×倍数 再衰减重排）
MEMORY_RAG_CANDIDATE_MULTIPLIER=3

# 用户发消息后闲置多久触发 extract（分钟）；再次发消息会重置
MEMORY_EXTRACT_IDLE_MINUTES=15

# 用户发消息后闲置多久才考虑触发 maintain→profile（小时）；发消息会重置
MEMORY_MAINTAIN_IDLE_HOURS=6

# 距上次 maintain 管线完成至少该小时数后才执行
MEMORY_MAINTAIN_MIN_INTERVAL_HOURS=12

# 发给 LLM 的最近历史消息条数上限
CHAT_CONTEXT_MESSAGE_LIMIT=30

# 每用户每天（UTC 日历日）单聊 + 群聊合计次数上限
CHAT_DAILY_TURN_LIMIT=100

# 每用户每天（UTC 日历日）新建角色次数上限
CHARACTER_CREATE_DAILY_LIMIT=10
# =======================================

# ============= 画像与离线 Job（必填）===========
# 画像 refresh 参考记忆条数上限（含 event；一次性日程由提示词排除）
MEMORY_PROFILE_REFERENCE_LIMIT=30

# 结构化 LLM 输出（提取/维护/画像）失败重试次数
LLM_STRUCTURED_MAX_RETRIES=2

# memory_jobs 保留条数，超出 prune
MEMORY_JOB_MAX_HISTORY=20

# Chroma metadata 缺 confidence 时的默认值 (0,1]
MEMORY_DEFAULT_CONFIDENCE=0.7
# =======================================

# ============= 认证（必填）===========
# 会话 token 哈希盐；生产环境请使用足够长的随机字符串
AUTH_SESSION_SECRET=change-me-in-production
# 登录会话有效天数
AUTH_SESSION_TTL_DAYS=30
# 登录 Cookie 名称
AUTH_SESSION_COOKIE_NAME=lilia_session
# 注册 / 登录限流
AUTH_RATE_LIMIT_REGISTER_PER_IP_HOUR=5
AUTH_RATE_LIMIT_REGISTER_PER_IP_DAY=15
AUTH_RATE_LIMIT_LOGIN_PER_IP_MINUTE=30
AUTH_RATE_LIMIT_LOGIN_PER_USERNAME_15MIN=10
# Cloudflare Turnstile（本地可用官方测试 Key；生产用 lilialab.net 控制台正式 Key）
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# =======================================

# ============= 官方账号（必填）===========
# seed 创建该用户并把 prisma/characters.json 挂到其名下；ownerId 相等即为官方角色
OFFICIAL_USERNAME=admin
OFFICIAL_PASSWORD=change-me-official-password
# =======================================
