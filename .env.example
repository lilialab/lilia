NODE_ENV=development

# ============= MySQL（必填）===========
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=pai_arbor
# =======================================

# ============= Chroma（必填）===========
CHROMA_HOST=localhost
CHROMA_PORT=8000
# =======================================

# ============= MinIO（必填）===========
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword
MINIO_BUCKET_NAME=pai-arbor
MINIO_ENDPOINT=http://localhost:9000
# =======================================

# ============= Redis / BullMQ（必填）===========
# compose 起 Redis 后使用此地址（BullMQ 连接）
REDIS_URL=redis://localhost:6379
# =======================================

# ============= 日志 / Loki（必填）===========
LOG_LEVEL=debug
LOKI_URL=http://localhost:3100
LOG_TO_LOKI=true
# =======================================

# ============= Ollama（必填）===========
# OLLAMA_HOST 可选：不设则默认 http://127.0.0.1:11434/api；也可通过 export OLLAMA_HOST=<HOST> 注入
OLLAMA_MODEL=gemma4:26b
OLLAMA_EMBED_MODEL=nomic-embed-text
# =======================================

# ============= 记忆衰减半衰期（必填）===========
# 用于聊天 RAG 排序与维护近邻 decay；详见 docs/memory/maintain.md
# event 型：lastActiveAt 距今达此天数时 decay≈0.5
MEMORY_HALF_LIFE_EVENT_DAYS=30

# preference 型半衰期（天）
MEMORY_HALF_LIFE_PREFERENCE_DAYS=90

# fact 型半衰期（天）
MEMORY_HALF_LIFE_FACT_DAYS=90
# =======================================

# ============= 记忆维护（必填）===========
# 每条游标最多召回的语义近邻数
MEMORY_MAINTENANCE_NEIGHBOR_LIMIT=10

# 近邻 decay 硬过滤阈值 (0,1]；低于此值不进入 LLM 合并簇
# 聊天 RAG 会 touch 语义命中并回写 lastActiveAt，仍被聊到的旧记忆保持活跃
# 过滤久未 touch 的近邻，无需担心跳过重要旧记忆；默认 0.25≈2×半衰期
MEMORY_MAINTENANCE_NEIGHBOR_MIN_DECAY=0.25
# =======================================

# ============= 聊天 RAG（必填）===========
# 进入 system prompt 的记忆条数上限
MEMORY_RAG_LIMIT=5

# Chroma 候选倍数（先召回 limit×倍数 再衰减重排）
MEMORY_RAG_CANDIDATE_MULTIPLIER=3

# 用户发消息后闲置多久触发 extract（分钟）；再次发消息会重置
MEMORY_EXTRACT_IDLE_MINUTES=15

# 用户发消息后闲置多久才考虑触发 maintain→profile（小时）；发消息会重置
MEMORY_MAINTAIN_IDLE_HOURS=6

# 距上次 maintain 管线完成至少该小时数后才执行
MEMORY_MAINTAIN_MIN_INTERVAL_HOURS=12

# 发给 LLM 的最近历史消息条数上限
CHAT_CONTEXT_MESSAGE_LIMIT=10
# =======================================

# ============= 画像与离线 Job（必填）===========
# 画像 refresh 参考记忆条数上限（排除 event）
MEMORY_PROFILE_REFERENCE_LIMIT=30

# 结构化 LLM 输出（整理/维护/画像）失败重试次数
LLM_STRUCTURED_MAX_RETRIES=2

# consolidation_jobs 保留条数，超出 prune
CONSOLIDATION_JOB_MAX_HISTORY=20

# Chroma metadata 缺 confidence 时的默认值 (0,1]
MEMORY_DEFAULT_CONFIDENCE=0.7
# =======================================

# ============= 知识库 RAG（必填）===========
# 文档知识库检索条数上限
KNOWLEDGE_RAG_LIMIT=10
# =======================================

# ============= 认证（必填）===========
# 会话 token 哈希盐；生产环境请使用足够长的随机字符串
AUTH_SESSION_SECRET=change-me-in-production
# 登录会话有效天数
AUTH_SESSION_TTL_DAYS=7
# 登录 Cookie 名称
AUTH_SESSION_COOKIE_NAME=pai_arbor_session
# 注册 / 登录限流
AUTH_RATE_LIMIT_REGISTER_PER_IP_HOUR=5
AUTH_RATE_LIMIT_REGISTER_PER_IP_DAY=15
AUTH_RATE_LIMIT_LOGIN_PER_IP_MINUTE=30
AUTH_RATE_LIMIT_LOGIN_PER_USERNAME_15MIN=10
# =======================================
